# ---- copy to .env and fill in as you enable each stage ----

# Script generation (optional). If Ollama is not running, a beat-sheet fallback is used.
OLLAMA_HOST=http://127.0.0.1:11434

# Visuals (optional). Without a key the pipeline renders procedural backgrounds.
# Free key: https://www.pexels.com/api/
PEXELS_API_KEY=

# ---- YouTube ----
# Download client secret JSON from Google Cloud Console > APIs & Services > Credentials
# (OAuth client, type "Desktop app"), save as secrets/yt_client_secret.json
YT_CLIENT_SECRET=secrets/yt_client_secret.json
YT_TOKEN=secrets/yt_token.json

# ---- Instagram (Graph API) ----
# facebook  = graph.facebook.com, needs a Page-linked IG business account.
#             One app covers Instagram Reels + Facebook Reels. Use this.
# instagram = graph.instagram.com, Instagram Login, no Page required.
#             Simpler, but cannot publish Facebook Reels.
IG_LOGIN_TYPE=facebook
IG_USER_ID=
IG_ACCESS_TOKEN=
IG_GRAPH_VERSION=v21.0

# ---- Facebook Reels (same Meta app, Page token) ----
FB_PAGE_ID=
FB_PAGE_TOKEN=
FB_GRAPH_VERSION=v21.0

# Needed only by scripts/meta_setup.py, to turn a 1-hour user token into 60 days
META_APP_ID=
META_APP_SECRET=

# Public hosting for the Reels video_url (Instagram cannot pull from your laptop)
# host options: none | r2 | gh_release
IG_HOST=none
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE=
GH_RELEASE_REPO=
